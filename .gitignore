# =========================
# DATA (VERY IMPORTANT)
# =========================

# Ignore ALL data by default
data/*

# But KEEP structure (README files)
!data/README.md
!data/**/
!data/**/README.md

# Ignore generated outputs
data/**/outputs/
data/**/cache/

# =========================
# LARGE FILES (BLOCK THEM)
# =========================
*.xlsx
*.xls
*.csv
*.tsv
*.parquet
*.zip
*.rar
*.7z

# =========================
# PUBLIC FOLDER (FRONTEND ASSETS)
# =========================

